{
  "name": "node-js",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npx nodemon dist/backend.js",
    "build:frontend": "tsc --watch --project tsconfig.frontend.json",
    "build:backend": "tsc --watch --project tsconfig.backend.json",
    "model": "tsc --watch --project tsconfig.model.json",
    "db": "tsc --watch --project tsconfig.db.json",
    "css": "npx tailwindcss -i ./public/index.css -o ./public/output.css --watch",
   "dev": "concurrently \"npm run build:frontend\" \"npm run db\" \"npm run model\" \"npm run build:backend\""

  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@types/express": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
